// # oodiff Project Anchor
//
// Logline: Names the four oodiff domains and the one job each one owns.
//
// Setup: Skeleton. Imports nothing and re-exports nothing; it exists to be the map.
//
// Beats:
//   1. Bind walk, match, render, and ipc to a single responsibility each.
//   2. Leave the domain list readable so a missing domain is obvious.

pub fn oodiff_domains() -> List[String] {
    let d: List[String] = list_new();
    let d2: List[String] = list_push(d, "walk: operands to comparable streams");
    let d3: List[String] = list_push(d2, "match: two streams to an edit script");
    let d4: List[String] = list_push(d3, "render: edit script to diff text");
    return list_push(d4, "ipc: CLI, MCP stdio, and AF_UNIX socket");
}
