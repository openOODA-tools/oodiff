// # oodiff Entry Point
//
// Logline: Argument gate and pipeline orchestrator for file and directory comparison.
//
// Setup: Requires FsReadCap for file access and ProcessCap to set exit status.
//
// Beats:
//   1. Handle --help, --version, and --mcp early.
//   2. Pair operands and run comparison across all files.
//   3. Set exit code 0 for identical, 1 for diffs found, 2 for trouble.

import "walk/anchor.oo";
import "walk/pair_operands.oo";
import "match/anchor.oo";
import "match/edit_op.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";
import "ipc/diff_opts.oo";

pub fn main(fs: &FsReadCap, proc_cap: &ProcessCap, args: List[String]) -> Result[Int, String] {
    let opts: DiffOpts = ipc_parse_args(args);

    if opts.help_mode {
        print(render_help());
        return Ok(0);
    }
    if opts.version_mode {
        print("oodiff 0.1.0 (openOODA sovereign diff)\n");
        return Ok(0);
    }
    if opts.mcp_mode {
        ipc_run_mcp(fs);
        return Ok(0);
    }

    if chars_len(opts.error_msg) > 0 {
        print("oodiff: " + opts.error_msg + "\nTry 'oodiff --help' for more information.\n");
        process_exit(2);
        return Ok(2);
    }

    let op_a: String = list_get(opts.operands, 0);
    let op_b: String = list_get(opts.operands, 1);

    let pairs: List[FilePair] = walk_pair_operands(fs, op_a, op_b, opts.recursive);
    let n_pairs: Int = list_len(pairs);
    let mut any_diff: Bool = false;

    let mut i: Int = 0;
    while i < n_pairs {
        let p: FilePair = list_get(pairs, i);

        if !opts.recursive {
            if p.file_a.missing {
                print("oodiff: " + op_a + ": " + p.file_a.error_msg + "\n");
                process_exit(2);
                return Ok(2);
            }
            if p.file_b.missing {
                print("oodiff: " + op_b + ": " + p.file_b.error_msg + "\n");
                process_exit(2);
                return Ok(2);
            }
        }

        if p.only_in_a {
            print(render_only_in(op_a, p.rel_path));
            any_diff = true;
        } else if p.only_in_b {
            print(render_only_in(op_b, p.rel_path));
            any_diff = true;
        } else {
            let script: EditScript = match_compute_script(p.file_a.lines, p.file_b.lines, p.file_a.has_trailing_newline, p.file_b.has_trailing_newline);
            if script.has_diff {
                any_diff = true;
                let text: String = render_diff_pair(
                    script,
                    p.label_a,
                    p.label_b,
                    list_len(p.file_a.lines),
                    list_len(p.file_b.lines),
                    p.file_a.has_trailing_newline,
                    p.file_b.has_trailing_newline,
                    p.file_a.is_binary,
                    p.file_b.is_binary,
                    opts.context,
                    opts.brief,
                    opts.use_color
                );
                print(text);
            }
        }
        i = i + 1;
    }

    if any_diff {
        process_exit(1);
        return Ok(1);
    }

    process_exit(0);
    return Ok(0);
}

fn render_help() -> String {
    return "usage: oodiff [options] from-file to-file\n"
        + "Compare files line by line.\n\n"
        + "  -u, -U NUM, --unified[=NUM]  output NUM (default 3) lines of unified context\n"
        + "  -r, --recursive              recursively compare any subdirectories found\n"
        + "  -q, --brief                  report only when files differ\n"
        + "  -i, --ignore-case            ignore case differences in file contents\n"
        + "  -w, --ignore-all-space       ignore all white space\n"
        + "      --color                  colorize the output\n"
        + "      --no-color               do not colorize output\n"
        + "      --mcp                    run in Model Context Protocol mode over stdio\n"
        + "  -h, --help                   display this help and exit\n"
        + "  -v, -V, --version            output version information and exit\n";
}
