// # Match Subsystem Anchor - Two Streams To An Edit Script
//
// Logline: Computes the edit script that turns one line stream into the other.
//
// Setup: Pure: no FS, net, or env, so a script can be asserted by hand.
//
// Beats:
//   1. Strip common prefix and suffix in linear time.
//   2. Compute bounded Myers edit script over the diverging middle segment.
//   3. Assemble whole aligned EditScript with exact line numbering.

import "edit_op.oo";
import "common_trim.oo";
import "myers_lcs.oo";

pub fn match_compute_script(a: List[String], b: List[String], has_nl_a: Bool, has_nl_b: Bool) -> EditScript {
    let na: Int = list_len(a);
    let nb: Int = list_len(b);

    if na == 0 && nb == 0 {
        return EditScript { items: list_new(), has_diff: false, a_count: 0, b_count: 0 };
    }

    let bounds: TrimBounds = compute_trim_bounds(a, b, has_nl_a, has_nl_b);
    let p: Int = bounds.prefix_len;
    let s: Int = bounds.suffix_len;

    let mut full_items: List[EditItem] = list_new();
    let mut any_diff: Bool = has_nl_a != has_nl_b;

    // 1. Prefix items
    let mut pi: Int = 0;
    while pi < p {
        let it_pre: EditItem = EditItem {
            op: op_equal(),
            text: list_get(a, pi),
            line_a: pi + 1,
            line_b: pi + 1
        };
        full_items = list_push(full_items, it_pre);
        pi = pi + 1;
    }

    // 2. Middle slice
    let mid_a_len: Int = na - p - s;
    let mid_b_len: Int = nb - p - s;
    if mid_a_len > 0 || mid_b_len > 0 {
        any_diff = true;
        let mut mid_a: List[String] = list_new();
        let mut ma_i: Int = 0;
        while ma_i < mid_a_len {
            mid_a = list_push(mid_a, list_get(a, p + ma_i));
            ma_i = ma_i + 1;
        }

        let mut mid_b: List[String] = list_new();
        let mut mb_i: Int = 0;
        while mb_i < mid_b_len {
            mid_b = list_push(mid_b, list_get(b, p + mb_i));
            mb_i = mb_i + 1;
        }

        if mid_a_len == 1 && mid_b_len == 1 && list_get(mid_a, 0) == list_get(mid_b, 0) && has_nl_a != has_nl_b {
            let it_del: EditItem = EditItem {
                op: op_delete(),
                text: list_get(mid_a, 0),
                line_a: p + 1,
                line_b: 0
            };
            let it_ins: EditItem = EditItem {
                op: op_insert(),
                text: list_get(mid_b, 0),
                line_a: 0,
                line_b: p + 1
            };
            full_items = list_push(full_items, it_del);
            full_items = list_push(full_items, it_ins);
        } else {
            let mid_items: List[EditItem] = solve_myers(mid_a, mid_b, p, p);
            let n_mid: Int = list_len(mid_items);
            let mut mi: Int = 0;
            while mi < n_mid {
                full_items = list_push(full_items, list_get(mid_items, mi));
                mi = mi + 1;
            }
        }
    }

    // 3. Suffix items
    let mut si: Int = 0;
    while si < s {
        let line_num_a: Int = na - s + si + 1;
        let line_num_b: Int = nb - s + si + 1;
        let it_suf: EditItem = EditItem {
            op: op_equal(),
            text: list_get(a, na - s + si),
            line_a: line_num_a,
            line_b: line_num_b
        };
        full_items = list_push(full_items, it_suf);
        si = si + 1;
    }

    return EditScript {
        items: full_items,
        has_diff: any_diff,
        a_count: na,
        b_count: nb
    };
}
