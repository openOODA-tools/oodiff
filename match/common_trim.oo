// # Common Prefix and Suffix Trimmer
//
// Logline: Rapidly prunes identical leading and trailing lines before diff matching.
//
// Setup: Pure comparison over two string lists in linear time.
//
// Beats:
//   1. Measure identical leading lines from index 0.
//   2. Measure identical trailing lines up to the remaining middle segment.
//   3. Return prefix and suffix boundary counts.

pub type TrimBounds = struct {
    prefix_len: Int,
    suffix_len: Int
};

pub fn compute_trim_bounds(
    a: List[String],
    b: List[String],
    norm_a: List[String],
    norm_b: List[String],
    hashes_a: List[Int],
    hashes_b: List[Int],
    has_nl_a: Bool,
    has_nl_b: Bool
) -> TrimBounds {
    let na: Int = list_len(a);
    let nb: Int = list_len(b);
    let limit: Int = if na < nb { na } else { nb };
    let max_p: Int = if has_nl_a != has_nl_b && limit > 0 { limit - 1 } else { limit };
    let mut p: Int = 0;
    while p < max_p && list_get(hashes_a, p) == list_get(hashes_b, p) && list_get(norm_a, p) == list_get(norm_b, p) {
        p = p + 1;
    }
    let max_s: Int = if has_nl_a != has_nl_b && limit > 0 { limit - 1 } else { limit };
    let mut s: Int = 0;
    while s < (max_s - p) && list_get(hashes_a, na - 1 - s) == list_get(hashes_b, nb - 1 - s) && list_get(norm_a, na - 1 - s) == list_get(norm_b, nb - 1 - s) {
        s = s + 1;
    }
    return TrimBounds {
        prefix_len: p,
        suffix_len: s
    };
}
